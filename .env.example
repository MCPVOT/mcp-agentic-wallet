# Environment variables for mcp-agentic-wallet server

# ── Treasury / Spender ────────────────────────────────────────────
# The address that receives USDC payments. This is the `spender` in
# the EIP-2612 permit — the human signs a permit allowing this address
# to spend their USDC via transferFrom.
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# ── Hot Wallet (for gas) ──────────────────────────────────────────
# A SINGLE-PURPOSE EOA with ETH for gas. This wallet submits the
# permit() and transferFrom() transactions on-chain.
# ⚠️ Never use this key for anything else.
# ⚠️ Never commit this to git — use env vars only.
HOT_WALLET_PRIVATE_KEY=0x_your_hot_wallet_private_key_here

# ── Base RPC ──────────────────────────────────────────────────────
# Default: mainnet.base.org (rate-limited). For production, use a
# dedicated RPC (Alchemy, Infura, QuickNode, etc.)
BASE_RPC_URL=https://mainnet.base.org

# ── Optional: Vercel KV / Redis for session persistence ────────────
# Without KV, sessions are stored in-memory and lost on cold starts.
# For production, set KV_REST_API_URL and KV_REST_API_TOKEN.
# KV_URL=redis://...
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...

# ── Wallet UI ─────────────────────────────────────────────────────
# The treasury address shown in the wallet UI (client-side)
NEXT_PUBLIC_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# ── Network ────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_CHAIN_ID=8453
NEXT_PUBLIC_APP_URL=http://localhost:3000
